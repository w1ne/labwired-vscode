{
    "name": "labwired-vscode",
    "displayName": "LabWired",
    "version": "0.14.0",
    "license": "MIT",
    "publisher": "w1ne",
    "description": "Debug firmware on a virtual chip (breakpoints, registers, reverse step) and connect shared LabWired agent tools (MCP) for compile / run / verify.",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Debuggers",
        "Visualization",
        "Testing"
    ],
    "activationEvents": [
        "onCommand:labwired.compileAndRun",
        "onCommand:labwired.configureAgentTools",
        "onCommand:labwired.configureModel",
        "onCommand:labwired.copyAgentInstall",
        "onCommand:labwired.copyClaudeMcpInstall",
        "onCommand:labwired.signIn",
        "onCommand:labwired.signOut",
        "onCommand:labwired.startOpenCodeAgent",
        "onDebugResolve:labwired",
        "onView:labwired.simulator",
        "workspaceContains:**/Cargo.toml",
        "workspaceContains:**/Makefile",
        "workspaceContains:.labwired/lab.yaml"
    ],
    "contributes": {
        "authentication": [
            {
                "id": "labwired",
                "label": "LabWired"
            }
        ],
        "configuration": {
            "title": "LabWired",
            "properties": {
                "labwired.apiUrl": {
                    "type": "string",
                    "default": "https://api.labwired.com",
                    "description": "LabWired API base URL (sign-in and hosted MCP at <apiUrl>/mcp). Default: https://api.labwired.com"
                },
                "labwired.demoUi.mode": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "off",
                        "on"
                    ],
                    "default": "auto",
                    "description": "Demo-only Command Center HUD/UART widgets. 'auto' enables in development mode and disables in production installs."
                },
                "labwired.dapPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the labwired-dap debug adapter. Leave empty to use the binary from the downloaded LabWired release."
                },
                "labwired.telemetry.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Report extension failures (never messages, paths or file names — only an enumerated class and a fingerprint). VS Code's own telemetry setting also governs this: turning that off turns this off."
                },
                "labwired.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the labwired CLI binary used by the configuration wizard."
                },
                "labwired.cliVersion": {
                    "type": "string",
                    "default": "v0.25.0",
                    "description": "LabWired release tag the extension downloads. The tarball carries both the labwired CLI and the labwired-dap debug adapter (from v0.19.3 onward)."
                },
                "labwired.agentPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the labwired agent launcher (OpenCode entry). Empty = auto-detect ~/.labwired/bin/labwired or PATH."
                }
            }
        },
        "debuggers": [
            {
                "type": "labwired",
                "label": "LabWired Debug",
                "program": "./out/extension.js",
                "runtime": "node",
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the ELF firmware file; defaults to inputs.firmware in .labwired/lab.yaml"
                            },
                            "systemConfig": {
                                "type": "string",
                                "description": "Path to the system configuration YAML; defaults to inputs.system in .labwired/lab.yaml"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Automatically stop at the entry point after launch",
                                "default": true
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory for the simulation",
                                "default": "${workspaceFolder}"
                            },
                            "args": {
                                "type": "array",
                                "description": "Command line arguments passed to the program",
                                "default": [],
                                "items": {
                                    "type": "string"
                                }
                            },
                            "env": {
                                "type": "object",
                                "description": "Environment variables passed to the program",
                                "default": {}
                            },
                            "trace": {
                                "type": "boolean",
                                "description": "Enable verbose DAP logging",
                                "default": false
                            }
                        }
                    },
                    "executionMode": {
                        "type": "string",
                        "enum": [
                            "local",
                            "docker"
                        ],
                        "default": "local",
                        "description": "Where to run the simulation and debugger."
                    },
                    "docker": {
                        "type": "object",
                        "properties": {
                            "image": {
                                "type": "string",
                                "default": "w1ne/labwired-dev:latest",
                                "description": "Docker image to use for simulation and building."
                            },
                            "autoPull": {
                                "type": "boolean",
                                "default": true,
                                "description": "Automatically pull the Docker image if missing."
                            },
                            "runArgs": {
                                "type": "array",
                                "default": [],
                                "description": "Additional arguments for 'docker run'.",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "labwired",
                        "request": "launch",
                        "name": "LabWired: Debug firmware",
                        "stopOnEntry": true
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "labwired.compileAndRun",
                "title": "Run Test (lab.yaml)",
                "icon": "$(play)",
                "category": "LabWired"
            },
            {
                "command": "labwired.showRegisters",
                "title": "Show Registers",
                "category": "LabWired"
            },
            {
                "command": "labwired.showDashboard",
                "title": "Show Command Center",
                "category": "LabWired"
            },
            {
                "command": "labwired.showTopology",
                "title": "Show System Topology",
                "category": "LabWired"
            },
            {
                "command": "labwired.showTimeline",
                "title": "Show Timeline",
                "category": "LabWired"
            },
            {
                "command": "labwired.showGraphing",
                "title": "Show Logic Analyzer",
                "category": "LabWired"
            },
            {
                "command": "labwired.showMemoryInspector",
                "title": "Show Memory Inspector",
                "category": "LabWired"
            },
            {
                "command": "labwired.showTraceList",
                "title": "Show Instruction Trace",
                "category": "LabWired"
            },
            {
                "command": "labwired.showProfiling",
                "title": "Show Performance Profiler",
                "category": "LabWired"
            },
            {
                "command": "labwired.startSimulator",
                "title": "Start Simulator",
                "icon": "$(play)",
                "category": "LabWired"
            },
            {
                "command": "labwired.stopSimulator",
                "title": "Stop Simulator",
                "icon": "$(stop)",
                "category": "LabWired"
            },
            {
                "command": "labwired.restartSimulator",
                "title": "Restart Simulator",
                "icon": "$(refresh)",
                "category": "LabWired"
            },
            {
                "command": "labwired.configureProject",
                "title": "Configure Project\u2026",
                "icon": "$(gear)",
                "category": "LabWired"
            },
            {
                "command": "labwired.configureModel",
                "title": "Configure Model",
                "icon": "$(gear)",
                "category": "LabWired"
            },
            {
                "command": "labwired.signIn",
                "title": "Sign In",
                "category": "LabWired"
            },
            {
                "command": "labwired.signOut",
                "title": "Sign Out",
                "category": "LabWired"
            },
            {
                "command": "labwired.configureAgentTools",
                "title": "Configure Agent Tools",
                "category": "LabWired"
            },
            {
                "command": "labwired.copyClaudeMcpInstall",
                "title": "Copy Claude MCP Install Command",
                "category": "LabWired"
            },
            {
                "command": "labwired.startOpenCodeAgent",
                "title": "Start OpenCode Agent",
                "category": "LabWired",
                "icon": "$(terminal)"
            },
            {
                "command": "labwired.copyAgentInstall",
                "title": "Copy Agent Install Command",
                "category": "LabWired"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "labwired",
                    "title": "LabWired",
                    "icon": "$(circuit-board)"
                }
            ]
        },
        "views": {
            "labwired": [
                {
                    "type": "webview",
                    "id": "labwired.commandCenter",
                    "name": "Command Center",
                    "icon": "$(circuit-board)"
                },
                {
                    "id": "labwired.simulator",
                    "name": "Simulator Management",
                    "icon": "$(play-circle)"
                },
                {
                    "id": "labwired.peripherals",
                    "name": "Peripherals",
                    "icon": "$(chip)"
                },
                {
                    "id": "labwired.rtos_tasks",
                    "name": "RTOS Tasks",
                    "icon": "$(layers)"
                }
            ]
        },
        "menus": {
            "editor/title": [
                {
                    "command": "labwired.compileAndRun",
                    "group": "navigation",
                    "when": "resourceExtname == .rs || resourceExtname == .c || resourceExtname == .cpp || resourceExtname == .h"
                }
            ],
            "commandPalette": [
                {
                    "command": "labwired.compileAndRun",
                    "when": "true"
                }
            ]
        }
    },
    "main": "./out/extension.js",
    "extensionKind": [
        "workspace"
    ],
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./out/test/runTest.js",
        "test:unit": "npm run compile && mocha out/test/unit/**/*.test.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/js-yaml": "^4.0.9",
        "@types/mocha": "^10.0.1",
        "@types/node": "^16.x",
        "@types/vscode": "^1.75.0",
        "@vscode/test-electron": "^2.3.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "typescript": "^4.9.5",
        "@vscode/vsce": "^3.2.0"
    },
    "dependencies": {
        "js-yaml": "^4.3.0",
        "tar": "^6.2.1"
    },
    "icon": "media/icon.png",
    "keywords": [
        "embedded",
        "firmware",
        "simulator",
        "debugger",
        "cortex-m",
        "risc-v",
        "esp32",
        "stm32",
        "nrf52",
        "arm",
        "mcp",
        "agent",
        "labwired"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/w1ne/labwired-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/w1ne/labwired-vscode/issues"
    },
    "homepage": "https://labwired.com",
    "galleryBanner": {
        "color": "#14161c",
        "theme": "dark"
    }
}
